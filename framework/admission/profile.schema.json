{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-owned managed admission startup profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "socket",
    "namespace",
    "contract_sha256",
    "subject_key_env",
    "delegation_keys",
    "models",
    "max_operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "socket": {
      "type": "string",
      "maxLength": 103,
      "pattern": "^/.*/control\\.sock$"
    },
    "namespace": {
      "type": "string",
      "format": "uuid"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject_key_env": {
      "type": "string",
      "pattern": "^BIFROST_MANAGED_[A-Z0-9_]{1,96}$"
    },
    "delegation_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "secret_env",
          "gateway_virtual_key_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "secret_env": {
            "type": "string",
            "pattern": "^BIFROST_MANAGED_[A-Z0-9_]{1,96}$"
          },
          "gateway_virtual_key_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true,
            "maxItems": 128,
            "minItems": 1
          }
        }
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "pool",
          "provider",
          "model"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "pool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "native_aliases": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "model",
          "source_alias"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "source_alias": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "shared_legacy_vk_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "delegated_credential_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "uniqueItems": true,
      "maxItems": 128
    },
    "max_operations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  }
}
